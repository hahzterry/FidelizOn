{
  "name": "fidelizon-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Monorepo da plataforma FidelizOn v2.0 (SaaS B2B2C Web3)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fidelizon/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "seed:sanity": "npx sanity datasets import ./packages/sanity-schemas/data/seed-cafeteria-aroma.ndjson production --project=8fgufitv --replace",
    "prepare": "node -e \"if (!process.env.CI && !process.env.VERCEL) require('child_process').execSync('npx --no-install husky', {stdio:'inherit'})\""
  },
  "keywords": [
    "loyalty",
    "web3",
    "thirdweb",
    "sanity",
    "pwa",
    "erc4337",
    "github-pages"
  ],
  "author": "FidelizOn Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
